<mxfile host="app.diagrams.net" type="device"><diagram id="giving" name="Giving a wish"><mxGraphModel dx="940" dy="1448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1448" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="giving-h0" value="Bob makes a wish" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Verdana;fontColor=#1d1f24;fontSize=20;fontStyle=1;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="380" height="56" as="geometry"/></mxCell><mxCell id="giving-h1" value="Alice gives it to him" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Verdana;fontColor=#1d1f24;fontSize=20;fontStyle=1;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="24" width="380" height="56" as="geometry"/></mxCell><mxCell id="giving-band0" value="What happens next" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="860" height="28" as="geometry"/></mxCell><mxCell id="giving-b1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Log in&lt;/b&gt;&lt;br&gt;Type your Email and Password, then click &lt;b&gt;Login&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-b1-num" value="1" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2f5f9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="127" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-b2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Open your lists&lt;/b&gt;&lt;br&gt;In the menu, click &lt;b&gt;Wishlists&lt;/b&gt;, then &lt;b&gt;My lists&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-b2-num" value="2" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2f5f9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="291" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-b3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pick the right list&lt;/b&gt;&lt;br&gt;Open the &lt;b&gt;Wishlist&lt;/b&gt; drop-down and choose the list." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-b3-num" value="3" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2f5f9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-b4" value="&lt;b style=&quot;font-size:20px&quot;&gt;Start a new wish&lt;/b&gt;&lt;br&gt;Click &lt;b&gt;Add a wish&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="604" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-b4-num" value="4" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2f5f9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="619" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-b5" value="&lt;b style=&quot;font-size:20px&quot;&gt;Paste the link&lt;/b&gt;&lt;br&gt;Paste the &lt;b&gt;Link to the product&lt;/b&gt;. wishthis fills in the rest. Check the Title and Priority." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-b5-num" value="5" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2f5f9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="783" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-b6" value="&lt;b style=&quot;font-size:20px&quot;&gt;Save it&lt;/b&gt;&lt;br&gt;Click &lt;b&gt;Add&lt;/b&gt;. You see: “Wish successfully created.”" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="932" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-b6-num" value="6" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2f5f9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="947" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-a1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Log in&lt;/b&gt;&lt;br&gt;Type your Email and Password, then click &lt;b&gt;Login&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="112" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-a1-num" value="1" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="127" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-a2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Open remembered lists&lt;/b&gt;&lt;br&gt;In the menu, click &lt;b&gt;Wishlists&lt;/b&gt;, then &lt;b&gt;Remembered lists&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="276" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-a2-num" value="2" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="291" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-a3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Open Bob’s list&lt;/b&gt;&lt;br&gt;Under the name &lt;b&gt;Bob&lt;/b&gt;, click his list." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="440" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-a3-num" value="3" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-a4" value="&lt;b style=&quot;font-size:20px&quot;&gt;Look at a wish&lt;/b&gt;&lt;br&gt;Find one to give, then click &lt;b&gt;Details&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="604" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-a4-num" value="4" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="619" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-a5" value="&lt;b style=&quot;font-size:20px&quot;&gt;Claim it&lt;/b&gt;&lt;br&gt;Click &lt;b&gt;Fulfil wish&lt;/b&gt;. You see: “Thank you!”" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="768" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-a5-num" value="5" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="783" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-a6" value="&lt;b style=&quot;font-size:20px&quot;&gt;Buy it&lt;/b&gt;&lt;br&gt;Click &lt;b&gt;Visit&lt;/b&gt; to open the store, then buy it there." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="932" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-a6-num" value="6" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="947" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-r1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everyone else&lt;/b&gt;&lt;br&gt;The wish is gone from Bob’s list for everyone else, so nobody buys it twice." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e6f4ea;strokeColor=#2e7d4f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1140" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-r1-num" value="✓" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d4f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="1155" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-r2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Bob&lt;/b&gt;&lt;br&gt;Bob still sees the wish on his own list. The surprise is kept." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e6f4ea;strokeColor=#2e7d4f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="380" height="128" as="geometry"/></mxCell><mxCell id="giving-r2-num" value="✓" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d4f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="1155" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-n1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Good to know&lt;/b&gt;&lt;br&gt;Bob’s own Details window has a &lt;b&gt;Mark as fulfilled&lt;/b&gt; button. That one is for Bob, after he receives the gift. People giving a gift click &lt;b&gt;Fulfil wish&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#fff6cc;strokeColor=#9a7800;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1304" width="860" height="104" as="geometry"/></mxCell><mxCell id="giving-n1-num" value="!" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#9a7800;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="1319" width="34" height="34" as="geometry"/></mxCell><mxCell id="giving-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-b1" target="giving-b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-b2" target="giving-b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-b3" target="giving-b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-b4" target="giving-b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-b5" target="giving-b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e5" value="Later" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-b6" target="giving-a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-a1" target="giving-a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-a2" target="giving-a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-a3" target="giving-a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-a4" target="giving-a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-a5" target="giving-a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="giving-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="giving-a6" target="giving-r1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="undo" name="Out of stock: undo it"><mxGraphModel dx="940" dy="1264" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1264" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="undo-h0" value="Alice" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Verdana;fontColor=#1d1f24;fontSize=20;fontStyle=1;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="380" height="56" as="geometry"/></mxCell><mxCell id="undo-h1" value="Good to know" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Verdana;fontColor=#1d1f24;fontSize=20;fontStyle=1;fillColor=#fff6cc;strokeColor=#9a7800;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="24" width="380" height="56" as="geometry"/></mxCell><mxCell id="undo-s0" value="&lt;b style=&quot;font-size:20px&quot;&gt;Earlier&lt;/b&gt;&lt;br&gt;Alice clicked &lt;b&gt;Fulfil wish&lt;/b&gt; on one of Bob’s wishes." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=16;spacingTop=10;spacingRight=10;fillColor=#f1f1ef;strokeColor=#77736a;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="380" height="104" as="geometry"/></mxCell><mxCell id="undo-w1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Bad news from the store&lt;/b&gt;&lt;br&gt;It is out of stock. There will be no more for three months." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#fdeee4;strokeColor=#b5522b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-w1-num" value="!" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#b5522b;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="291" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Open your gifts&lt;/b&gt;&lt;br&gt;In the menu, click &lt;b&gt;Wishlists&lt;/b&gt;, then &lt;b&gt;My gifts&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-c2-num" value="1" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-c3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Find the gift&lt;/b&gt;&lt;br&gt;Find the row with the wish. The &lt;b&gt;For&lt;/b&gt; column says Bob." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="604" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-c3-num" value="2" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="619" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-c4" value="&lt;b style=&quot;font-size:20px&quot;&gt;Undo it&lt;/b&gt;&lt;br&gt;Click &lt;b&gt;Undo&lt;/b&gt;. You see: “The wish is available again.”" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-c4-num" value="3" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="783" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-c5" value="&lt;b style=&quot;font-size:20px&quot;&gt;Back on the list&lt;/b&gt;&lt;br&gt;The wish is back on Bob’s list, for everyone to see." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e6f4ea;strokeColor=#2e7d4f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="932" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-c5-num" value="✓" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2e7d4f;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="947" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-c6" value="&lt;b style=&quot;font-size:20px&quot;&gt;Pick another wish&lt;/b&gt;&lt;br&gt;Open Bob’s list again and click &lt;b&gt;Details&lt;/b&gt; on a different wish. (Giving a wish, step 4.)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#f3eafa;strokeColor=#7a3f9d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1096" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-c6-num" value="4" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#7a3f9d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="53" y="1111" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-m1" value="&lt;b style=&quot;font-size:20px&quot;&gt;Shortcut&lt;/b&gt;&lt;br&gt;Still see the “Thank you!” message? Click its &lt;b&gt;Undo&lt;/b&gt; button instead." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#fff6cc;strokeColor=#9a7800;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="440" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-m1-num" value="!" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#9a7800;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-m2" value="&lt;b style=&quot;font-size:20px&quot;&gt;Do it soon&lt;/b&gt;&lt;br&gt;&lt;b&gt;Undo&lt;/b&gt; works for 60 minutes after clicking &lt;b&gt;Fulfil wish&lt;/b&gt;." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#fff6cc;strokeColor=#9a7800;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="768" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-m2-num" value="!" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#9a7800;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="783" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-m3" value="&lt;b style=&quot;font-size:20px&quot;&gt;Bob’s view&lt;/b&gt;&lt;br&gt;Nothing changes for Bob. The wish stayed on his list the whole time." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;spacingLeft=58;spacingTop=10;spacingRight=10;fillColor=#e8f0fb;strokeColor=#2f5f9e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="932" width="380" height="128" as="geometry"/></mxCell><mxCell id="undo-m3-num" value="B" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=18;fontStyle=1;fontColor=#ffffff;fillColor=#2f5f9e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="533" y="947" width="34" height="34" as="geometry"/></mxCell><mxCell id="undo-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="undo-s0" target="undo-w1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="undo-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="undo-w1" target="undo-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="undo-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="undo-c2" target="undo-c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="undo-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="undo-c3" target="undo-c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="undo-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="undo-c4" target="undo-c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="undo-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#4a4f58;fontFamily=Verdana;fontColor=#1d1f24;fontSize=17;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="undo-c5" target="undo-c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
